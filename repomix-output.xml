<file path="frontend/css/booking-flow.css">
/* ============================================
   Booking Flow Styles
   ============================================ */

.steps {
  display: flex;
  justify-content: center;
  gap: 16px;
  padding: 30px 20px;
  flex-wrap: wrap;
}

.step {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 50px;
  background: var(--white);
  color: var(--text-mid);
  border: 1.5px solid var(--border);
  font-weight: 500;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.step span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--pink-soft);
  color: var(--pink-deep);
  font-weight: 600;
  font-size: 0.85rem;
}

.step.active {
  background: var(--pink-main);
  color: var(--white);
  border-color: var(--pink-main);
}

.step.active span {
  background: var(--white);
  color: var(--pink-deep);
}

.step.done {
  background: var(--gold-soft);
  border-color: var(--gold);
  color: var(--pink-deep);
}

/* Flow Section */
.flow-section {
  padding: 20px 40px 40px;
  max-width: 1100px;
  margin: 0 auto;
}

.flow-title {
  font-size: 1.5rem;
  color: var(--pink-deep);
  margin-bottom: 8px;
  text-align: center;
}

.flow-subtitle {
  text-align: center;
  color: var(--text-mid);
  margin-bottom: 24px;
  font-size: 0.95rem;
}

/* Back Button */
.btn-back {
  background: none;
  border: none;
  color: var(--pink-deep);
  font-family: "Poppins", sans-serif;
  font-size: 0.9rem;
  cursor: pointer;
  padding: 8px 0;
  margin-bottom: 16px;
  transition: color 0.2s;
}

.btn-back:hover {
  color: var(--pink-main);
}

/* Selection Cards */
.studio-list,
.sport-list,
.room-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}

.studio-card,
.sport-card,
.room-card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  border: 1.5px solid var(--border);
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.studio-card:hover,
.sport-card:hover,
.room-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--pink-main);
}

.studio-card h3,
.sport-card h3,
.room-card h3 {
  color: var(--pink-deep);
  font-size: 1.15rem;
  margin-bottom: 6px;
}

.studio-card p,
.sport-card p,
.room-card p {
  color: var(--text-mid);
  font-size: 0.88rem;
  margin-bottom: 4px;
}

.sports-tag {
  display: inline-block;
  background: var(--gold-soft);
  color: var(--pink-deep);
  font-size: 0.75rem;
  padding: 4px 10px;
  border-radius: 50px;
  margin-top: 10px;
  font-weight: 500;
}

.room-card .times {
  font-size: 0.8rem;
  color: var(--pink-deep);
  margin-top: 8px;
}

.room-card .btn-primary {
  margin-top: 12px;
  width: 100%;
}

/* Filters (Room Page) */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding: 20px;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
  margin-bottom: 24px;
  align-items: end;
}

.filters label {
  display: flex;
  flex-direction: column;
  font-size: 0.85rem;
  color: var(--text-mid);
  flex: 1;
  min-width: 140px;
}

.filters input,
.filters select {
  margin-top: 6px;
}

.card-image {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

.step {
  cursor: not-allowed;
}
.step.done,
.step.active {
  cursor: pointer;
}
.step.done:hover,
.step.active:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.table-thumb {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
}

.admin-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.tab-btn {
  padding: 8px 16px;
  border-radius: 50px;
  border: 1.5px solid var(--border);
  background: var(--white);
  color: var(--text-dark);
  font-family: "Poppins", sans-serif;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.tab-btn:hover {
  background: var(--pink-soft);
}
.tab-btn.active {
  background: var(--pink-main);
  color: var(--white);
  border-color: var(--pink-main);
}

.recommend-setting {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 20px 0;
}

.recommend-setting label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.95rem;
  cursor: pointer;
}

.recommend-setting input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: var(--pink-main);
}

/* ========== Card Image ========== */
.card-image {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

/* ========== Trainer Image ========== */
.trainer-image {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  object-fit: cover;
  margin: 0 auto 12px;
  border: 3px solid var(--pink-soft);
  display: block;
}
