<file path="frontend/css/course.css">
/* ============================================
   Course Page
   ============================================ */

.section-subtitle {
  text-align: center;
  color: var(--text-mid);
  font-size: 0.95rem;
  margin-bottom: 30px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

/* Filters */
.filters {
  display: flex;
  justify-content: center;
  gap: 16px;
  padding: 20px;
  margin-bottom: 20px;
}

.filters label {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 15px;
  font-size: 0.85rem;
  color: var(--text-mid);
  min-width: 180px;
}

.filters select {
  margin-top: 0;
}

/* Course Grid */
.course-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  padding: 20px 40px 60px;
  max-width: 1200px;
  margin: 0 auto;
}

/* Course Card */
.course-card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
  transition: all 0.3s ease;
  position: relative;
  display: flex;
  flex-direction: column;
}

.course-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: var(--pink-main);
}

.course-card .level {
  display: inline-block;
  align-self: flex-start;
  background: var(--pink-soft);
  color: var(--pink-deep);
  font-size: 0.75rem;
  padding: 4px 12px;
  border-radius: 50px;
  font-weight: 500;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.course-card .level[data-level="Beginner"] {
  background: #e8f5e9;
  color: #4caf50;
}

.course-card .level[data-level="Intermediate"] {
  background: #fff3e0;
  color: #ff9800;
}

.course-card .level[data-level="Advanced"] {
  background: #fce4ec;
  color: #e91e63;
}

.course-card h3 {
  color: var(--pink-deep);
  font-size: 1.25rem;
  margin-bottom: 8px;
  font-family: "Playfair Display", serif;
}

.course-card .duration {
  color: var(--text-mid);
  font-size: 0.88rem;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.course-card .duration svg {
  width: 14px;
  height: 14px;
  stroke: var(--pink-main);
}

.course-card .fee {
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--gold);
  margin: 12px 0;
  font-family: "Playfair Display", serif;
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.course-card .btn-primary {
  width: 100%;
  margin-top: auto;
}

.course-card .course-image {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

/* ========== Enrolled Card ========== */
.course-card.is-enrolled {
  opacity: 0.8;
  background: var(--pink-bg);
}

.course-card.is-enrolled .course-image {
  filter: grayscale(30%);
}

/* ========== Enrolled Button ========== */
.course-card .btn-primary.enrolled {
  background: linear-gradient(135deg, #7ebc89, #5aa06a) !important;
  color: var(--white) !important;
  cursor: default !important;
  opacity: 1 !important;
}

.course-card .btn-primary.enrolled:hover {
  transform: none;
  box-shadow: none;
}

/* ========== Enroll Modal Summary ========== */
.enroll-summary {
  text-align: left;
  background: var(--pink-bg);
  padding: 16px;
  border-radius: var(--radius-sm);
  margin-bottom: 24px;
  font-size: 0.9rem;
}

.enroll-summary-image {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

.enroll-summary p {
  margin-bottom: 6px;
  color: var(--text-dark);
}

.enroll-summary hr {
  border: none;
  border-top: 1px dashed var(--pink-main);
  margin: 12px 0;
}

/* ========== Prerequisite ========== */
.course-card .prerequisite {
  font-size: 0.8rem;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  margin: 6px 0;
  font-weight: 500;
}

.course-card .prerequisite.met {
  background: #e8f5e9;
  color: #4caf50;
}

.course-card .prerequisite.not-met {
  background: #ffebee;
  color: #f44336;
}

/* ========== Locked Card ========== */
.course-card.is-locked {
  opacity: 0.7;
}

.course-card.is-locked .course-image {
  filter: grayscale(60%);
}

.course-card .btn-primary.locked {
  background: var(--border) !important;
  color: var(--text-mid) !important;
  cursor: not-allowed !important;
  opacity: 1 !important;
}

.course-card .btn-primary.locked:hover {
  transform: none;
  box-shadow: none;
}

@media (max-width: 768px) {
  .course-list {
    grid-template-columns: 1fr;
    padding: 20px;
  }

  .filters {
    margin: 16px;
    padding: 16px;
  }
}
