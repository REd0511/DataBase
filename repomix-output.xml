  display: flex;
  justify-content: center;
  gap: 16px;
  padding: 20px;
  margin-bottom: 20px;
}

.filters label {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 15px;
  font-size: 0.85rem;
  color: var(--text-mid);
  min-width: 180px;
}

.filters select {
  margin-top: 0;
}

/* ========== Reward Grid ========== */
.reward-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
  padding: 20px 40px 60px;
  max-width: 1200px;
  margin: 0 auto;
}

/* ========== Reward Card ========== */
.reward-card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
  transition: all 0.3s ease;
  text-align: center;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.reward-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--pink-main), var(--gold));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.reward-card:hover::before {
  transform: scaleX(1);
}

.reward-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: var(--gold);
}

/* Category Badge */
.reward-card .category {
  display: inline-block;
  align-self: center;
  background: var(--gold-soft);
  color: var(--pink-deep);
  font-size: 0.72rem;
  padding: 4px 14px;
  border-radius: 50px;
  font-weight: 500;
  margin-bottom: 14px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.reward-card .category[data-cat="Beauty"] {
  background: #fce4ec;
  color: #d6739a;
}

.reward-card .category[data-cat="Sports"] {
  background: #e8f5e9;
  color: #4caf50;
}

.reward-card .category[data-cat="Discount"] {
  background: #fff3e0;
  color: #ff9800;
}

/* Reward Image */
.reward-card .reward-image {
  width: 100%;
  height: 140px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

/* Reward Title */
.reward-card h3 {
  color: var(--pink-deep);
  font-size: 1.15rem;
  margin-bottom: 8px;
  font-family: "Playfair Display", serif;
}

/* Points */
.reward-card .points {
  font-size: 1.4rem;
  color: var(--gold);
  font-weight: 600;
  margin: 12px 0;
  font-family: "Playfair Display", serif;
}

.reward-card .points::after {
  content: " pts";
  font-size: 0.85rem;
  color: var(--text-mid);
  font-family: "Poppins", sans-serif;
}

/* ============================================ */
/* Redeem Button (Base) */
/* ============================================ */
.reward-card .btn-primary {
  width: 100%;
  margin-top: auto;
}

/* Disabled (Not enough points) */
.reward-card .btn-primary:disabled {
  background: var(--border);
  color: var(--text-mid);
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* ============================================ */
/* Redeemed State (override disabled) */
/* ============================================ */
.reward-card .btn-primary.redeemed:disabled {
  background: linear-gradient(135deg, #7ebc89, #5aa06a) !important;
  color: var(--white) !important;
  cursor: default !important;
  opacity: 1 !important;
}

.reward-card .btn-primary.redeemed:disabled:hover {
  transform: none;
  box-shadow: none;
}

/* ============================================ */
/* Points Badge (Top) */
/* ============================================ */
.points-badge-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20px;
}

.points-badge {
  display: inline-grid;
  grid-template-columns: auto auto;
  align-items: end; /* ✅ จัดตามขอบล่าง */
  justify-content: center;
  gap: 10px;
  padding: 16px 36px;
  background: linear-gradient(135deg, var(--pink-main), var(--pink-deep));
  border-radius: 50px;
  color: var(--white);
  box-shadow: var(--shadow-md);
  min-width: 220px;
}

.points-badge span {
  font-size: 0.85rem;
  opacity: 0.9;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 500;
  line-height: 1.2;
  font-family: "Poppins", sans-serif;
}

.points-badge strong {
  font-size: 1.5rem;
  font-family: "Playfair Display", serif;
  font-weight: 700;
  line-height: 1;
  display: inline-flex;
  align-items: center;
}

/* ============================================ */
/* Redeemed Card State */
/* ============================================ */
.reward-card.is-redeemed {
  opacity: 0.75;
  background: var(--pink-bg);
}

.reward-card.is-redeemed::before {
  background: linear-gradient(90deg, #7ebc89, #5aa06a);
  transform: scaleX(1);
}

.reward-card.is-redeemed .reward-image {
  filter: grayscale(50%);
}

/* ============================================ */
/* Redeem Confirm Modal */
/* ============================================ */
.redeem-summary {
  text-align: left;
  background: var(--pink-bg);
  padding: 16px;
  border-radius: var(--radius-sm);
  margin-bottom: 24px;
  font-size: 0.9rem;
}

.redeem-summary-image {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

.redeem-summary p {
  margin-bottom: 6px;
  color: var(--text-dark);
}

.redeem-summary hr {
  border: none;
  border-top: 1px dashed var(--pink-main);
  margin: 12px 0;
}

/* ============================================ */
/* Responsive */
/* ============================================ */
@media (max-width: 768px) {
  .reward-list {
    grid-template-columns: 1fr;
    padding: 20px;
  }

  .filters {
    margin: 16px;
    padding: 16px;
  }
}
</file>

<file path="frontend/js/booking-flow.js">
/* ============================================
   booking-flow.js - Studio → Sport → Room (API Connected)
   FEATURES:
   - Step 1: Select Studio (from DB)
   - Step 2: Select Sport (filtered from DB)
   - Step 3: Select Room (check availability from API /api/rooms/available)
   ============================================ */

let flow = JSON.parse(localStorage.getItem("bookingFlow")) || {};

// Variables to store data from Database
let dbStudios = [];
let dbSports = [];
let dbRooms = [];

// ==================== INIT ====================
document.addEventListener("DOMContentLoaded", async () => {
  try {
    // 1. Fetch Master Data from API instead of Mock Data
    dbStudios = await SheSparksAPI.studios();
    dbSports = await SheSparksAPI.sports();
    dbRooms = await SheSparksAPI.rooms();

    // 2. Render current page
    if (document.getElementById("studio-list")) renderStudios();
    if (document.getElementById("sport-list")) renderSports();
    if (document.getElementById("room-list")) renderRooms();
  } catch (error) {
    console.error("Failed to load data from API:", error);
    alert("Cannot connect to database. Please check if Backend is running.");
  }
});

// find which sports a Studio has by checking ROOMS data in DB
function getSportsForStudio(studioCode) {
  // Find all SportTypeIDs that have rooms in this Studio
  const sportIdsInStudio = [...new Set(dbRooms.filter(r => r.StudioCode === studioCode).map(r => r.SportTypeID))];
  // Return sport objects
  return dbSports.filter(s => sportIdsInStudio.includes(s.SportTypeID));
}

// ==================== STEP 1: STUDIO ====================
function renderStudios() {
  const container = document.getElementById("studio-list");
  if (!container) return;

  container.innerHTML = dbStudios.map((s) => {
    const sports = getSportsForStudio(s.StudioCode)
      .map((st) => st.SportName)
      .join(" • ");

    return `
      <div class="studio-card" onclick="selectStudio('${s.StudioCode}')">
        ${s.ImageURL ? `<img src="${s.ImageURL}" class="card-image" alt="${s.Name}" onerror="this.style.display='none'">` : ""}
        <h3>${s.Name}</h3>
        <p>${s.Location}</p>
        <span class="sports-tag">${sports || "No sports"}</span>
      </div>
    `;
  }).join("");
}

function selectStudio(code) {
  flow.studio = dbStudios.find((s) => s.StudioCode === code);
  saveFlow();
  window.location.href = "/views/sport.html";
}

// ==================== STEP 2: SPORT ====================
function renderSports() {
  const container = document.getElementById("sport-list");
  if (!container || !flow.studio) return;

  const label = document.getElementById("selected-studio-label");
  if (label) label.textContent = `at ${flow.studio.Name}`;

  const sports = getSportsForStudio(flow.studio.StudioCode);

  if (sports.length === 0) {
    container.innerHTML = "<p>No sports available at this studio.</p>";
    return;
  }

  container.innerHTML = sports
    .map(
      (s) => `
    <div class="sport-card" onclick="selectSport(${s.SportTypeID})">
      ${s.ImageURL ? `<img src="${s.ImageURL}" class="card-image" alt="${s.SportName}" onerror="this.style.display='none'">` : ""}
      <h3>${s.SportName}</h3>
      <p>Intensity: ${s.IntensityLevel}</p>
    </div>
  `,
    )
    .join("");
}

function selectSport(sportTypeID) {
  flow.sport = dbSports.find((s) => s.SportTypeID === sportTypeID);
  saveFlow();
  window.location.href = "/views/room.html";
}

// ==================== STEP 3: ROOM ====================
function renderRooms(filteredRooms = null) {
  const container = document.getElementById("room-list");
  if (!container) return;

  if (!flow.studio || !flow.sport) {
    container.innerHTML = "<p>Please select Studio and Sport first.</p>";
    return;
  }

  const label = document.getElementById("selected-sport-label");
  if (label) {
    label.textContent = `${flow.sport.SportName} at ${flow.studio.Name}`;
  }

  const rooms = filteredRooms || dbRooms.filter(
      (r) => r.StudioCode === flow.studio.StudioCode && r.SportTypeID === flow.sport.SportTypeID
  );

  if (rooms.length === 0) {
    container.innerHTML = "<p>No rooms available for this selection.</p>";
    return;
  }

  container.innerHTML = rooms
    .map(
      (r) => {
        const sportName = dbSports.find(s => s.SportTypeID === r.SportTypeID)?.SportName || 'Unknown';
        return `
        <div class="room-card" onclick="openRoomModal(${r.RoomID})">
          ${r.ImageURL ? `<img src="${r.ImageURL}" class="card-image" alt="${r.RoomName}" onerror="this.style.display='none'">` : ""}
          <h3>${r.RoomName}</h3>
          <p>Capacity: ${r.Capacity} people</p>
          <p>Sport: ${sportName}</p>
          <button class="btn-primary">Select</button>
        </div>
      `})
    .join("");
}

// ==================== APPLY FILTERS ====================
async function applyFilters() {
  const date = document.getElementById("filterDate")?.value;
  const startTime = document.getElementById("filterStartTime")?.value;
  const endTime = document.getElementById("filterEndTime")?.value;
  const capacity = parseInt(document.getElementById("filterCapacity")?.value) || 1;

  // If no date/time selected → show all as normal
  if (!date || !startTime || !endTime) {
    renderRooms();
    return;
  }

  if (startTime >= endTime) {
    showModal({
      type: "warning",
      title: "Invalid time",
      message: "End time must be after start time",
    });
    return;
  }

  if (capacity < 1 || capacity > 30) {
    showModal({
      type: "warning",
      title: "Invalid capacity",
      message: "Number of people must be between 1 and 30",
    });
    return;
  }

  try {
    //  find available rooms directly 
    const availableRoomsFromApi = await SheSparksAPI.availableRooms(date, startTime, endTime);

    // Additional filter by Studio, Sport, and capacity
    const filtered = availableRoomsFromApi.filter((r) => {
      if (r.StudioCode !== flow.studio.StudioCode) return false;
      if (r.SportTypeID !== flow.sport.SportTypeID) return false;
      if (r.Capacity < capacity) return false;
      return true;
    });

    renderRooms(filtered);
  } catch (error) {
    console.error("Filter error:", error);
    showModal({ type: "error", title: "Error", message: "Cannot search for available rooms" });
  }
}

function clearFilters() {
  const dateEl = document.getElementById("filterDate");
  const startEl = document.getElementById("filterStartTime");
  const endEl = document.getElementById("filterEndTime");
  const capEl = document.getElementById("filterCapacity");

  if (dateEl) dateEl.value = "";
  if (startEl) startEl.value = "09:00";
  if (endEl) endEl.value = "11:00";
  if (capEl) capEl.value = "1";

  renderRooms();
}

// ==================== HELPERS ====================
function saveFlow() {
  localStorage.setItem("bookingFlow", JSON.stringify(flow));
}

function goBack() {
  window.history.back();
}
</file>

<file path="frontend/js/rewards.js">
/* ============================================
   rewards.js - Rewards Page (API Only)
   ============================================ */

let allRewards = [];
let userPoints = 0;
let userRedemptions = [];
let currentReward = null;

// ==================== INIT ====================
document.addEventListener("DOMContentLoaded", async () => {
  const user = JSON.parse(localStorage.getItem("user"));

  if (!user) {
    showModal({
      type: "warning",
      title: "Please Login",
      message: "Please login to view rewards",
      buttonText: "Go to Login",
      redirectTo: "/views/login.html",
    });
    return;
  }

  const memberId = user.MemberID || user.id;
  const container = document.getElementById("reward-list");

  if (container) {
    container.innerHTML = '<p style="text-align:center;grid-column:1/-1;color:var(--text-mid);">Loading rewards...</p>';
  }

  // 1. Load Points
  try {
    const pointsData = await SheSparksAPI.memberPoints(memberId);
    userPoints = Number(pointsData.Balance || 0);
  } catch (error) {
    console.warn("Cannot load points:", error.message);
    userPoints = 0;
  }

  // 2. Load Rewards
  try {
    const apiRewards = await SheSparksAPI.rewards();
    allRewards = Array.isArray(apiRewards) ? apiRewards : [];
    console.log("Loaded rewards:", allRewards.length, allRewards);
  } catch (error) {
    console.error("Cannot load rewards:", error);
    allRewards = [];
  }

  // 3. Load Redemptions
  try {
    const redemptions = await SheSparksAPI.get(`/rewards/member/${memberId}`);
    userRedemptions = Array.isArray(redemptions) ? redemptions : [];
  } catch (error) {
    console.warn("Cannot load redemptions:", error.message);
    userRedemptions = [];
  }

  renderPointsBadge();
  renderRewards(allRewards);
});

// ==================== RENDER POINTS BADGE ====================
function renderPointsBadge() {
  const badge = document.getElementById("userPointsBadge");
  if (badge) {
    badge.textContent = userPoints.toLocaleString();
  }
}

// ==================== RENDER REWARDS ====================
function renderRewards(rewards) {
  const container = document.getElementById("reward-list");
  if (!container) return;

  if (!rewards || rewards.length === 0) {
    container.innerHTML = `
      <div style="grid-column:1/-1;text-align:center;padding:60px 20px;">
        <p style="color:var(--text-mid);margin-bottom:16px;">No rewards available.</p>
        <button class="btn-secondary" onclick="location.reload()">Reload</button>
      </div>
    `;
    return;
  }

  container.innerHTML = rewards
    .map((r) => {
      const canAfford = userPoints >= r.PointCost;
      const isRedeemed = userRedemptions.some(
        (red) => Number(red.RewardID) === Number(r.RewardID),
      );

      let buttonHTML = "";
      if (isRedeemed) {
        buttonHTML = `<button class="btn-primary redeemed" disabled>✓ Redeemed</button>`;
      } else if (!canAfford) {
        buttonHTML = `<button class="btn-primary" disabled>Not enough points (${r.PointCost} pts needed)</button>`;
      } else {
        buttonHTML = `<button class="btn-primary" onclick="openRedeemModal(${r.RewardID})">Redeem</button>`;
      }

      return `
        <div class="reward-card ${isRedeemed ? "is-redeemed" : ""}">
          <span class="category" data-cat="${r.Category}">${r.Category}</span>
          ${
            r.ImageURL
              ? `<img src="${r.ImageURL}" class="reward-image" alt="${r.Name}" onerror="this.style.display='none'">`
              : ""
          }
          <h3>${r.Name}</h3>
          <p class="points">${r.PointCost}</p>
          ${buttonHTML}
        </div>
      `;
    })
    .join("");
}

// ==================== FILTER ====================
function filterRewards() {
  const cat = document.getElementById("categoryFilter").value;
  const filtered = cat
    ? allRewards.filter((r) => r.Category === cat)
    : allRewards;
  renderRewards(filtered);
}

// ==================== OPEN REDEEM MODAL ====================
function openRedeemModal(rewardId) {
  const reward = allRewards.find((r) => Number(r.RewardID) === Number(rewardId));
  if (!reward) return;

  currentReward = reward;

  if (userPoints < reward.PointCost) {
    showModal({
      type: "warning",
      title: "Not Enough Points",
      message: `You need ${reward.PointCost} points but you only have ${userPoints}.`,
    });
    return;
  }

  const modalHTML = `
    <div class="custom-modal-overlay" id="redeem-confirm-modal">
      <div class="custom-modal">
        <div class="custom-modal-icon warning">?</div>
        <h3>Confirm Redemption</h3>
        <p>Do you want to redeem this reward?</p>

        <div class="redeem-summary">
          ${reward.ImageURL ? `<img src="${reward.ImageURL}" alt="${reward.Name}" class="redeem-summary-image">` : ""}
          <p><strong>Reward:</strong> ${reward.Name}</p>
          <p><strong>Category:</strong> ${reward.Category}</p>
          <p><strong>Cost:</strong> ${reward.PointCost} pts</p>
          <hr style="margin: 12px 0; border: none; border-top: 1px dashed var(--pink-main);">
          <p><strong>Your Points:</strong> ${userPoints} pts</p>
          <p><strong>After Redeem:</strong> <span style="color: var(--pink-deep); font-weight: 700;">${userPoints - reward.PointCost} pts</span></p>
        </div>

        <div class="custom-modal-actions">
          <button class="btn-secondary" onclick="closeRedeemModal()">Cancel</button>
          <button class="btn-primary" onclick="confirmRedeem()">Confirm Redeem</button>
        </div>
      </div>
    </div>
  `;

  document.body.insertAdjacentHTML("beforeend", modalHTML);
  const modal = document.getElementById("redeem-confirm-modal");
  setTimeout(() => modal.classList.add("active"), 10);
}

// ==================== CLOSE REDEEM MODAL ====================
function closeRedeemModal() {
  const modal = document.getElementById("redeem-confirm-modal");
  if (modal) {
    modal.classList.remove("active");
    setTimeout(() => modal.remove(), 300);
  }
}

// ==================== CONFIRM REDEEM (API) ====================
async function confirmRedeem() {
  const user = JSON.parse(localStorage.getItem("user"));
  if (!user) return;

  const reward = currentReward;
  if (!reward) {
    showModal({
      type: "error",
      title: "Error",
      message: "Reward not found. Please try again.",
    });
    return;
  }

  closeRedeemModal();

  const memberId = user.MemberID || user.id;

  try {
    await SheSparksAPI.post("/rewards/redeem", {
      MemberID: Number(memberId),
      RewardID: Number(reward.RewardID),
      RedemptionDate: new Date().toISOString().split("T")[0],
      PointsUsed: reward.PointCost,
    });

    userPoints -= reward.PointCost;
    userRedemptions.push({
      RewardID: reward.RewardID,
      RedemptionDate: new Date().toISOString().split("T")[0],
    });

    currentReward = null;

    renderPointsBadge();
    renderRewards(allRewards);

    showModal({
      type: "success",
      title: "Redeemed Successfully!",
      message: `
        <strong>Reward:</strong> ${reward.Name}<br>
        <strong>Points Used:</strong> ${reward.PointCost}<br>
        <strong>Remaining Points:</strong> ${userPoints}
      `,
      buttonText: "View Points History",
      onClose: () => {
        window.location.href = "/views/points.html";
      },
    });
  } catch (error) {
    currentReward = null;
    showModal({
      type: "error",
      title: "Redeem Failed",
      message: error.message || "Cannot redeem reward",
    });
  }
}
</file>

<file path="frontend/js/trainer.js">
/* ============================================
   trainer.js - Trainer Selection (API Connected)
   ============================================ */

let dbAvailableTrainers = [];

document.addEventListener("DOMContentLoaded", async () => {
  const flow = JSON.parse(localStorage.getItem("bookingFlow"));
  if (!flow || !flow.sport || !flow.date) {
    alert("Please complete the booking flow first");
    window.location.href = "/views/booking.html";
    return;
  }

  const container = document.getElementById("trainer-list");
  if (container) {
    container.innerHTML = "<p style='text-align:center; width:100%; color:var(--text-mid);'>กำลังค้นหาเทรนเนอร์ที่ว่าง...</p>";
  }

  try {
    dbAvailableTrainers = await SheSparksAPI.availableTrainers(flow.date, flow.startTime, flow.endTime);
    renderTrainers(flow.sport.SportTypeID, flow.studio.StudioCode);
  } catch (error) {
    console.error("Failed to load trainers:", error);
    if (container) {
      container.innerHTML = `<p style="color:var(--danger); text-align:center;">ระบบขัดข้อง: ไม่สามารถโหลดข้อมูลเทรนเนอร์ได้</p>`;
    }
  }
});

function renderTrainers(sportTypeID, studioCode) {
  const container = document.getElementById("trainer-list");
  if (!container) return;

  // ✅ Fixed: only filter by SportTypeID (StudioCode may not be present on all rows)
  const trainers = dbAvailableTrainers.filter(
    (t) => String(t.SportTypeID) === String(sportTypeID)
  );

  if (trainers.length === 0) {
    container.style.gridTemplateColumns = "1fr";
    container.innerHTML = `
      <div style="text-align: center; padding: 60px 20px; background: var(--white); border-radius: var(--radius-md); border: 1px dashed var(--pink-main);">
        <h3 style="color: var(--pink-deep); margin-bottom: 12px; font-size: 1.4rem;">ไม่มีเทรนเนอร์ว่าง 😢</h3>
        <p style="color: var(--text-mid); margin-bottom: 24px;">
          ขออภัยค่ะ ไม่มีเทรนเนอร์คิวว่างสำหรับกีฬานี้ในช่วงเวลาที่คุณเลือก<br>
          คุณสามารถดำเนินการจองต่อโดยไม่ต้องใช้เทรนเนอร์ได้ค่ะ
        </p>
        <button class="btn-primary" onclick="goBack()">กลับไปหน้า Summary</button>
      </div>
    `;
    return;
  }

  container.style.gridTemplateColumns = "repeat(auto-fit, minmax(260px, 1fr))";
  container.innerHTML = trainers.map((t) => `
    <div class="trainer-card">
      ${t.ImageURL ? `<img src="${t.ImageURL}" class="trainer-image" alt="${t.Name}" onerror="this.style.display='none'">` : ""}
      <div class="avatar">${t.Name.split(" ")[1]?.[0] || "T"}</div>
      <h3>${t.Name}</h3>
      <span class="specialty">${t.SportName || "Trainer"}</span>
      <p>${t.Phone || "-"}</p>
      <button class="btn-primary" style="width:100%; margin-top:12px;" onclick="selectTrainer(${t.TrainerID})">Select</button>
    </div>
  `).join("");
}

function selectTrainer(id) {
  const flow = JSON.parse(localStorage.getItem("bookingFlow"));
  flow.trainer = dbAvailableTrainers.find((t) => t.TrainerID == id);
  localStorage.setItem("bookingFlow", JSON.stringify(flow));
  window.location.href = "/views/summary.html";
}

function goBack() {
  const flow = JSON.parse(localStorage.getItem("bookingFlow"));
  if (flow) {
    flow.wantTrainer = null;
    localStorage.setItem("bookingFlow", JSON.stringify(flow));
  }
  window.location.href = "/views/summary.html";
}
