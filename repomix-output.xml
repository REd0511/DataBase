<file path="frontend/css/admin.css">
/* ============================================
   Admin Dashboard
   ============================================ */

/* ========== Admin Sidebar Layout ========== */
.admin-layout {
  display: flex;
  min-height: calc(100vh - 80px);
  margin-top: 80px;
}

.admin-sidebar {
  width: 260px;
  background: var(--white);
  border-right: 1px solid var(--border);
  padding: 24px 16px;
  position: fixed;
  top: 80px;
  left: 0;
  bottom: 0;
  overflow-y: auto;
  z-index: 100;
}

.sidebar-title {
  color: var(--pink-deep);
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 20px;
  margin-bottom: 12px;
  padding-left: 12px;
  font-family: "Poppins", sans-serif;
  font-weight: 600;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 16px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  color: var(--text-dark);
  font-size: 0.88rem;
  font-weight: 500;
  transition: all 0.25s ease;
  cursor: pointer;
}

.sidebar-link:hover {
  background: var(--pink-soft);
  color: var(--pink-deep);
}

.sidebar-link.active {
  background: var(--pink-main);
  color: var(--white);
}

.sidebar-link svg {
  flex-shrink: 0;
}

.admin-main {
  flex: 1;
  margin-left: 260px;
  padding: 30px 40px;
  max-width: 100%;
  overflow-x: hidden;
}
.section-subtitle {
  text-align: center;
  color: var(--text-mid);
  font-size: 0.95rem;
  margin-bottom: 30px;
}

.admin-section {
  scroll-margin-top: 100px; /* เผื่อระยะเวลา Scroll ไปหา */
}

.admin-section + .admin-section {
  margin-top: 40px;
}

/* ========== Summary Cards ========== */
.summary-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  padding: 20px 40px 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.summary-cards .card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
  text-align: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.summary-cards .card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--pink-main), var(--gold));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.summary-cards .card:hover::before {
  transform: scaleX(1);
}

.summary-cards .card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.summary-cards .card-icon {
  width: 52px;
  height: 52px;
  margin: 0 auto 14px;
  border-radius: 50%;
  background: var(--pink-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.summary-cards .card-icon svg {
  width: 24px;
  height: 24px;
  stroke: var(--pink-deep);
}

.summary-cards .card h3 {
  font-size: 0.85rem;
  color: var(--text-mid);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
  font-family: "Poppins", sans-serif;
}

.summary-cards .card p {
  font-size: 2rem;
  font-family: "Playfair Display", serif;
  color: var(--pink-deep);
  font-weight: 700;
  line-height: 1;
}

/* ========== Reports ========== */
.report {
  max-width: 1000px;
  margin: 20px auto 40px;
  padding: 30px;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
}

.report h2 {
  color: var(--pink-deep);
  font-size: 1.3rem;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
  font-family: "Playfair Display", serif;
}

.report .filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding: 0 0 20px;
  margin: 0 0 20px;
  background: transparent;
  border: none;
  box-shadow: none;
  border-bottom: 1px solid var(--border);
  align-items: end;
}

.report .filters label {
  display: flex;
  flex-direction: column;
  font-size: 0.85rem;
  color: var(--text-mid);
  flex: 1;
  min-width: 140px;
}

.report .filters input {
  margin-top: 6px;
