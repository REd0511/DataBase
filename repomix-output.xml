/* ============================================
   Home Page - Hero + About + CTA
   ============================================ */

/* ========== HERO FULL SCREEN ========== */
.hero-full {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: flex-start;
   padding: 80px 80px 80px 80px;
  background: url("https://images.unsplash.com/photo-1518611012118-696072aa579a?w=1920") center/cover no-repeat;
  background-color: #2a1f23;
  overflow: hidden;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg,
      rgba(42, 31, 35, 0.85) 0%,
      rgba(42, 31, 35, 0.6) 50%,
      rgba(42, 31, 35, 0.3) 100%);
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 600px;
  color: var(--white);
}

.hero-subtitle {
  font-size: 0.85rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--pink-soft);
  margin-bottom: 24px;
  font-weight: 500;
  opacity: 0.9;
}

.hero-title {
  font-family: "Playfair Display", serif;
  font-size: 5rem;
  font-weight: 500;
  line-height: 1.05;
  color: var(--white);
  margin-bottom: 24px;
  letter-spacing: -1px;
}

.hero-accent {
  font-style: italic;
  color: var(--pink-soft);
}

.hero-description {
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 40px;
  max-width: 480px;
}

.hero-buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.hero-buttons .btn-primary {
  padding: 16px 36px;
  font-size: 1rem;
}

.btn-hero-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 36px;
  border: 1.5px solid rgba(255, 255, 255, 0.5);
  border-radius: 50px;
  color: var(--white);
  text-decoration: none;
  font-weight: 500;
  font-size: 1rem;
  transition: all 0.3s ease;
  background: transparent;
}

.btn-hero-secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--white);
}

/* ========== ABOUT SECTION ========== */
.about-section {
  padding: 100px 60px;
  background: linear-gradient(135deg, var(--pink-soft), var(--pink-bg));
}

.about-content {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}

.about-subtitle {
  font-size: 0.85rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--pink-deep);
  margin-bottom: 20px;
  font-weight: 500;
}

.about-title {
  font-family: "Playfair Display", serif;
  font-size: 3rem;
  color: var(--pink-deep);
  margin-bottom: 24px;
  line-height: 1.2;
}

.about-text {
  color: var(--text-mid);
  font-size: 1.05rem;
  line-height: 1.8;
  margin-bottom: 48px;
}

/* ========== CTA SECTION ========== */
.cta-section {
  padding: 100px 60px;
  background: linear-gradient(135deg, var(--pink-main), var(--pink-deep));
  text-align: center;
  color: var(--white);
}

.cta-content {
  max-width: 600px;
  margin: 0 auto;
}

.cta-title {
  font-family: "Playfair Display", serif;
  font-size: 2.5rem;
  color: var(--white);
  margin-bottom: 16px;
  line-height: 1.2;
}

.cta-text {
  font-size: 1.05rem;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 32px;
}

.cta-section .btn-primary {
  background: var(--white);
  color: var(--pink-deep);
  padding: 16px 40px;
  font-size: 1rem;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.cta-section .btn-primary:hover {
  background: var(--pink-bg);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}

/* ========== RESPONSIVE ========== */
@media (max-width: 992px) {
  .hero-full {
    padding: 0 40px;
  }

  .hero-title {
    font-size: 3.5rem;
  }

  .about-title {
    font-size: 2.2rem;
  }

  .cta-title {
    font-size: 2rem;
  }
}

@media (max-width: 768px) {
  .hero-full {
    min-height: 90vh;
    padding: 200px 24px 80px 24px;
    justify-content: center;
    text-align: center;
  }

  .hero-title {
    font-size: 2.5rem;
  }

  .hero-description {
    font-size: 1rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons {
    justify-content: center;
  }

  .hero-buttons .btn-primary,
  .btn-hero-secondary {
    padding: 12px 24px;
    font-size: 0.9rem;
  }

  .about-section,
  .cta-section {
    padding: 60px 24px;
  }

  .about-title {
    font-size: 1.8rem;
  }

  .cta-title {
    font-size: 1.6rem;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 2rem;
  }

  .hero-subtitle {
    font-size: 0.7rem;
    letter-spacing: 2px;
  }

  .hero-full {
    padding: 220px 20px 60px 20px; 
  }
}
</file>

<file path="frontend/css/navbar.css">
/* ============================================
   Navbar & Profile Popover
   ============================================ */

/* ========== Navbar Base (Default = White) ========== */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  padding: 16px 40px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: all 0.4s ease;
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}

.navbar.scrolled {
  box-shadow: var(--shadow-md);
  padding: 12px 40px;
}

/* ========== Navbar Transparent (Home Page Only) ========== */
.navbar.transparent-start {
  background: transparent;
  backdrop-filter: none;
  border-bottom: 1px solid transparent;
  box-shadow: none;
  padding: 20px 40px;
}

.navbar.transparent-start nav a:not(.profile-popover a) {
  color: var(--white);
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
}

.navbar.transparent-start nav a:hover:not(.profile-popover a) {
  background: rgba(255, 255, 255, 0.15);
  color: var(--white);
}

.navbar.transparent-start nav a.active {
  background: var(--pink-main);
  color: var(--white);
  text-shadow: none;
}

.navbar.transparent-start .profile-btn {
  border-color: rgba(255, 255, 255, 0.8);
}

.navbar.transparent-start .btn-login {
  background: var(--white);
  color: var(--pink-deep) !important;
  text-shadow: none !important;
}

/* ========== Logo ========== */
.navbar .logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.navbar .logo img {
  height: 70px;
  transition: all 0.3s ease;
}

.navbar.scrolled .logo img {
  height: 42px;
}

/* ========== Nav Links ========== */
.navbar nav {
  display: flex;
  align-items: center;
  gap: 6px;
}

.navbar nav a {
  color: var(--text-dark);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  padding: 8px 16px;
  border-radius: 50px;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 38px;
}

.navbar nav a:hover {
  background: var(--pink-soft);
  color: var(--pink-deep);
}

.navbar nav a.active {
  background: var(--pink-main);
  color: var(--white);
}

/* ========== Home Icon ========== */
.navbar nav a.home-icon {
  padding: 8px 12px;
}

.navbar nav a.home-icon svg {
  width: 18px;
  height: 18px;
  display: block;
  stroke-width: 2;
}

/* ========== Login Button ========== */
.navbar .btn-login {
  background: var(--pink-main);
  color: var(--white) !important;
  padding: 10px 24px !important;
  border-radius: 50px;
  font-weight: 600;
  transition: all 0.3s ease;
}

.navbar .btn-login:hover {
  background: var(--pink-deep);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(214, 115, 154, 0.3);
}

/* ========== Profile Button ========== */
.profile-wrapper {
  position: relative;
  display: inline-block;
}

.profile-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-main), var(--pink-deep));
  color: var(--white);
  font-weight: 600;
  font-size: 1rem;
  font-family: "Playfair Display", serif;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid var(--white);
  box-shadow: var(--shadow-sm);
  user-select: none;
}

.profile-btn:hover {
  transform: scale(1.08);
  box-shadow: 0 4px 16px rgba(214, 115, 154, 0.4);
}

/* ========== Profile Popover ========== */
.profile-popover {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  width: 300px;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
  padding: 20px;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.profile-popover.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.profile-popover::before {
  content: "";
  position: absolute;
  top: -8px;
  right: 16px;
  width: 14px;
  height: 14px;
  background: var(--white);
  border-left: 1px solid var(--border);
  border-top: 1px solid var(--border);
  transform: rotate(45deg);
}

.profile-popover .popover-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 16px;
}

.profile-popover .avatar-small {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-main), var(--pink-deep));
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  font-weight: 700;
  font-family: "Playfair Display", serif;
  flex-shrink: 0;
}

.profile-popover .user-info {
  flex: 1;
  min-width: 0;
}

.profile-popover .user-info h4 {
  font-size: 1rem;
  color: var(--pink-deep);
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-popover .user-info p {
  font-size: 0.78rem;
  color: var(--text-mid);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-popover .user-info .role-badge {
  display: inline-block;
  background: var(--pink-soft);
  color: var(--pink-deep);
  font-size: 0.7rem;
  padding: 2px 8px;
  border-radius: 50px;
  font-weight: 500;
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ========== Popover Points (Clickable) ========== */
.profile-popover .popover-points {
  background: var(--pink-bg);
  border: 1px dashed var(--pink-main);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  margin-bottom: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-decoration: none;
  transition: all 0.25s ease;
}

.profile-popover .popover-points.clickable {
  cursor: pointer;
}

.profile-popover .popover-points.clickable:hover {
  background: var(--pink-soft);
  border-color: var(--pink-deep);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.profile-popover .popover-points span {
  font-size: 0.8rem;
  color: var(--text-mid);
}

.profile-popover .popover-points .points-value {
  font-size: 1.2rem;
  font-family: "Playfair Display", serif;
  font-weight: 700;
  color: var(--pink-deep);
}

/* ========== Popover Links ========== */
.profile-popover .popover-links {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 12px;
}

.profile-popover .popover-links a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  color: var(--text-dark);
  font-size: 0.9rem;
  transition: all 0.2s ease;
}

.profile-popover .popover-links a:hover {
  background: var(--pink-soft);
  color: var(--pink-deep);
}

.profile-popover .popover-links a svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  flex-shrink: 0;
}

/* ========== Logout Button ========== */
.profile-popover .btn-logout {
  width: 100%;
  padding: 10px;
  background: transparent;
  color: var(--danger);
  border: 1.5px solid var(--danger);
  border-radius: var(--radius-sm);
  font-family: "Poppins", sans-serif;
  font-weight: 500;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.profile-popover .btn-logout:hover {
  background: var(--danger);
  color: var(--white);
}

/* ============================================
   Responsive: Navbar
   ============================================ */
@media (max-width: 992px) {
  .navbar {
    padding: 14px 20px;
  }

  .navbar nav a {
    padding: 6px 10px;
    font-size: 0.88rem;
  }
}

@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .navbar nav {
    flex-wrap: wrap;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .profile-popover {
    width: 260px;
    right: -8px;
  }
}
